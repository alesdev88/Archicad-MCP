! Swept Beam, User Interface Script: four pages (spec 1.6, end cuts on page 4)

UI_DIALOG "Swept Beam"
UI_CURRENT_PAGE gs_ui_current_page

UI_PAGE 1, -1, "Path"
UI_STYLE 2, 1
UI_OUTFIELD "Path", 12, 10, 420, 22
UI_STYLE 0, 0
UI_SEPARATOR 12, 34, 432, 34
UI_OUTFIELD "Slope (%)", 18, 50, 245, 18
UI_INFIELD "slopePercent", 278, 48, 146, 19
UI_BUTTON UI_FUNCTION, "Apply slope", 278, 74, 146, 22, 1
UI_OUTFIELD "Curve tolerance", 18, 110, 245, 18
UI_INFIELD "pathTolerance", 278, 108, 146, 19
UI_OUTFIELD "Grips", 18, 134, 245, 18
UI_INFIELD "gripMode", 278, 132, 146, 19
UI_OUTFIELD "Reference line at", 18, 158, 245, 18
UI_INFIELD "refLine", 278, 156, 146, 19
UI_OUTFIELD "Offset from the reference line", 18, 182, 245, 18
UI_INFIELD "refOffset", 278, 180, 146, 19
UI_STYLE 1, 2
UI_OUTFIELD "Faces as seen from the first node. Offset moves the beam away (Centre: right).", 18, 204, 406, 16
UI_OUTFIELD "Nodes: " + STR (VARDIM1 (nodeX), 1, 0) + ". Exact values and roll: parameter list.", 18, 222, 330, 16
UI_STYLE 0, 0
UI_BUTTON UI_NEXT, "Next >", 352, 244, 72, 20

UI_PAGE 2, -1, "Profile"
UI_STYLE 2, 1
UI_OUTFIELD "Profile", 12, 10, 420, 22
UI_STYLE 0, 0
UI_SEPARATOR 12, 34, 432, 34
UI_OUTFIELD "Section source", 18, 44, 245, 18
UI_INFIELD "profileMode", 278, 42, 146, 19
IF profileMode = "Profile attribute" THEN
    UI_OUTFIELD "Profile", 18, 68, 245, 18
    UI_INFIELD "beamProfile", 278, 66, 146, 19
ENDIF
UI_OUTFIELD "Rectangle width (also the fallback)", 18, 92, 245, 18
UI_INFIELD "rectW", 278, 90, 146, 19
UI_OUTFIELD "Rectangle height", 18, 116, 245, 18
UI_INFIELD "rectH", 278, 114, 146, 19
UI_OUTFIELD "Rectangle building material", 18, 140, 245, 18
UI_INFIELD "rectBMat", 278, 138, 146, 19
UI_OUTFIELD "Section origin shift: side / up", 18, 164, 245, 18
UI_INFIELD "profileOffsetU", 278, 162, 70, 19
UI_INFIELD "profileOffsetW", 354, 162, 70, 19
UI_OUTFIELD "Flip section", 18, 188, 245, 18
UI_INFIELD "flipProfile", 278, 186, 146, 19
UI_OUTFIELD "Override surfaces", 18, 212, 245, 18
UI_INFIELD "overrideSurface", 278, 210, 20, 19
IF overrideSurface THEN UI_INFIELD "surfaceOverride", 304, 210, 120, 19
UI_BUTTON UI_PREV, "< Back", 12, 244, 72, 20
UI_BUTTON UI_NEXT, "Next >", 352, 244, 72, 20

UI_PAGE 3, -1, "Floor plan"
UI_STYLE 2, 1
UI_OUTFIELD "Floor plan", 12, 10, 420, 22
UI_STYLE 0, 0
UI_SEPARATOR 12, 34, 432, 34
UI_OUTFIELD "Outline pen", 18, 46, 245, 18
UI_INFIELD "outlinePen", 278, 44, 70, 19
UI_OUTFIELD "Show reference axis", 18, 70, 245, 18
UI_INFIELD "showAxis", 278, 68, 146, 19
IF showAxis THEN
    UI_OUTFIELD "Axis pen / line type", 18, 94, 245, 18
    UI_INFIELD "axisPen", 278, 92, 70, 19
    UI_INFIELD "axisLineType", 354, 92, 70, 19
ENDIF
UI_OUTFIELD "Show node heights", 18, 118, 245, 18
UI_INFIELD "showNodeHeights", 278, 116, 146, 19
IF showNodeHeights THEN
    UI_OUTFIELD "Text pen / size (mm)", 18, 142, 245, 18
    UI_INFIELD "textPen", 278, 140, 70, 19
    UI_INFIELD "textSizeMm", 354, 140, 70, 19
ENDIF
UI_OUTFIELD "Show plan fill", 18, 166, 245, 18
UI_INFIELD "showPlanFill", 278, 164, 20, 19
IF showPlanFill THEN
    UI_INFIELD "planFill", 304, 164, 120, 19
    UI_OUTFIELD "Fill pen / background", 18, 190, 245, 18
    UI_INFIELD "fillFgPen", 278, 188, 70, 19
    UI_INFIELD "fillBgPen", 354, 188, 70, 19
ENDIF
UI_BUTTON UI_PREV, "< Back", 12, 244, 72, 20
UI_BUTTON UI_NEXT, "Next >", 352, 244, 72, 20

UI_PAGE 4, -1, "Ends"
UI_STYLE 2, 1
UI_OUTFIELD "Ends", 12, 10, 420, 22
UI_STYLE 0, 0
UI_SEPARATOR 12, 34, 432, 34
UI_OUTFIELD "Start cut: in plan / tilt", 18, 50, 245, 18
UI_INFIELD "cutStartPlan", 278, 48, 70, 19
UI_INFIELD "cutStartTilt", 354, 48, 70, 19
UI_OUTFIELD "End cut: in plan / tilt", 18, 78, 245, 18
UI_INFIELD "cutEndPlan", 278, 76, 70, 19
UI_INFIELD "cutEndTilt", 354, 76, 70, 19
UI_OUTFIELD "Tilt for a vertical face: start " + STR (ecPlumb[1], 2, 1) + ", end " + STR (ecPlumb[2], 2, 1), 18, 106, 406, 18
UI_STYLE 1, 2
UI_OUTFIELD "In plan: turns the cut counter-clockwise from square, up to 80 degrees.", 18, 134, 406, 20
UI_OUTFIELD "Tilt: 0 is square to the beam; positive leans the top of the face out.", 18, 156, 406, 20
UI_OUTFIELD "The plan cut can also be turned with the grip beside each end.", 18, 178, 406, 20
UI_STYLE 0, 0
UI_BUTTON UI_PREV, "< Back", 12, 244, 72, 20
