! Swept Beam -- 2D Script
! Plan symbol: a projection of the 3D model (spec 1.5). parts = 1+2+4+8 keeps
! the 3D grips out of the plan. planMethod: 2 hidden lines, 3 shading (cut
! polygons exist only with 3); +32 draws with the current pen.

planMethod = 2 + 32

IF nPath < 2 THEN
    LINE2 -0.1, 0, 0.1, 0
    LINE2 0, -0.1, 0, 0.1
ELSE
    PEN outlinePen
    PROJECT2{3} 3, 270, planMethod, 1 + 2 + 4 + 8
ENDIF

! the axis node to node as true lines and arcs, so a dashed line type runs on
! (drawn through every sample, each short piece restarted the pattern)
IF showAxis AND nNode > 1 THEN
    PEN axisPen
    LINE_TYPE axisLineType
    FOR iS = 1 TO nNode - 1
        IF segIsArc[iS] THEN
            IF segAng[iS] > 0 THEN
                ARC2 segCx[iS], segCy[iS], segR[iS], segA0[iS], segA0[iS] + segAng[iS]
            ELSE
                ARC2 segCx[iS], segCy[iS], segR[iS], segA0[iS] + segAng[iS], segA0[iS]
            ENDIF
        ELSE
            LINE2 nodeX[iS], nodeY[iS], nodeX[iS + 1], nodeY[iS + 1]
        ENDIF
    NEXT iS
ENDIF

IF showNodeHeights THEN
    DEFINE STYLE "sbHeights" "Arial", MAX (0.5, textSizeMm), 1, 0
    SET STYLE "sbHeights"
    PEN textPen
    FOR iN = 1 TO nNode
        TEXT2 nodeX[iN], nodeY[iN], STR ("%.3m", GLOB_ELEVATION + nodeZ[iN])
    NEXT iN
ENDIF

! ---- grips, filtered by the Grips setting ----
showNodeGrips = (gripMode = "All" OR gripMode = "Nodes")
showCurveGrips = (gripMode = "All" OR gripMode = "Curves")
showAddGrips = (gripMode = "All" OR gripMode = "Add nodes")

! node grips: combined nodeX / nodeY drag (reference, Example 2)
IF showNodeGrips THEN
    FOR iN = 1 TO nNode
        hId = 100000 + iN * 10
        HOTSPOT2 nodeX[iN], 0, hId, nodeY[iN], 1 + 128
        HOTSPOT2 nodeX[iN], -1, hId + 1, nodeY[iN], 3
        HOTSPOT2 nodeX[iN], nodeY[iN], hId + 2, nodeY[iN], 2, nodeY[iN], "Node " + STR (iN, 1, 0) + " y"
        HOTSPOT2 0, nodeY[iN], hId + 3, nodeX[iN], 1 + 128
        HOTSPOT2 -1, nodeY[iN], hId + 4, nodeX[iN], 3
        HOTSPOT2 nodeX[iN], nodeY[iN], hId + 5, nodeX[iN], 2, nodeX[iN], "Node " + STR (iN, 1, 0) + " x"
    NEXT iN
ENDIF

FOR jS = 1 TO nNode - 1
    gdx = nodeX[jS + 1] - nodeX[jS]
    gdy = nodeY[jS + 1] - nodeY[jS]
    gChord = SQR (gdx * gdx + gdy * gdy)
    IF gChord > EPS THEN
        gux = gdx / gChord
        guy = gdy / gChord
        ! curve grip: segSag, sideways at the chord midpoint
        IF showCurveGrips AND jS <= VARDIM1 (segSag) THEN
            gmx = (nodeX[jS] + nodeX[jS + 1]) / 2
            gmy = (nodeY[jS] + nodeY[jS + 1]) / 2
            hId = 200000 + jS * 10
            HOTSPOT2 gmx, gmy, hId, segSag[jS], 1 + 128
            HOTSPOT2 gmx - guy, gmy + gux, hId + 1, segSag[jS], 3
            HOTSPOT2 gmx + guy * segSag[jS], gmy - gux * segSag[jS], hId + 2, segSag[jS], 2, segSag[jS], "Curve segment " + STR (jS, 1, 0) + ": bulge"
        ENDIF
        ! insert grip: insL, slides along the chord from node jS
        IF showAddGrips AND jS <= VARDIM1 (insL) THEN
            hId = 300000 + jS * 10
            HOTSPOT2 nodeX[jS], nodeY[jS], hId, insL[jS], 1 + 128
            HOTSPOT2 nodeX[jS] - gux, nodeY[jS] - guy, hId + 1, insL[jS], 3
            HOTSPOT2 nodeX[jS] + gux * insL[jS], nodeY[jS] + guy * insL[jS], hId + 2, insL[jS], 2, insL[jS], "Insert node on segment " + STR (jS, 1, 0) + ": slide, release"
        ENDIF
    ENDIF
NEXT jS

! add-node grips past the ends, along the end directions
IF showAddGrips AND nNode > 1 THEN
    geX = eTx[nNode - 1]
    geY = eTy[nNode - 1]
    HOTSPOT2 nodeX[nNode], nodeY[nNode], 390000, extEnd, 1 + 128
    HOTSPOT2 nodeX[nNode] - geX, nodeY[nNode] - geY, 390001, extEnd, 3
    HOTSPOT2 nodeX[nNode] + geX * extEnd, nodeY[nNode] + geY * extEnd, 390002, extEnd, 2, extEnd, "Add node at the end: slide out, release"
    gsX = sTx[1]
    gsY = sTy[1]
    HOTSPOT2 nodeX[1], nodeY[1], 390010, extStart, 1 + 128
    HOTSPOT2 nodeX[1] + gsX, nodeY[1] + gsY, 390011, extStart, 3
    HOTSPOT2 nodeX[1] - gsX * extStart, nodeY[1] - gsY * extStart, 390012, extStart, 2, extStart, "Add node at the start: slide out, release"
ENDIF
