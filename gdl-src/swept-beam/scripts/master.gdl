! Swept Beam, Master Script
! Samples the node path into pathX/pathY/pathZ/pathRoll for the 2D and 3D
! scripts. Height and roll change linearly with plan length along each
! segment, so an arc with a rise is a helix (spec 1.4).

EPS = 0.0001
! where the add-node grips rest past the ends (shared by the 2D and Parameter scripts)
EXT_PARK = 0.25
nNode = MIN (VARDIM1 (nodeX), VARDIM1 (nodeY), VARDIM1 (nodeZ), VARDIM1 (nodeRoll), VARDIM1 (segArc))
tolSafe = MAX (0.0001, pathTolerance)

DIM pathX[], pathY[], pathZ[], pathRoll[], tList[]
! per segment: plan unit tangent and rise at its start (s) and end (e);
! per node: its index in the sampled path
DIM sTx[], sTy[], sTz[], eTx[], eTy[], eTz[], nodePath[]
! per segment, for drawing the axis as true lines and arcs in plan
DIM segIsArc[], segAng[], segCx[], segCy[], segR[], segA0[]
! Extra samples this far from each segment end keep the segment's own plumb
! frame between them. TUBE places a joint's averaged frame at a node, and
! without them that twist would warp a whole straight segment (gate A).
STUB_LEN = 0.02
nPath = 0
startTX = 1
startTY = 0
startTZ = 0
endTX = 1
endTY = 0
endTZ = 0

FOR iSeg = 1 TO nNode - 1
    x1 = nodeX[iSeg]
    y1 = nodeY[iSeg]
    z1 = nodeZ[iSeg]
    r1 = nodeRoll[iSeg]
    x2 = nodeX[iSeg + 1]
    y2 = nodeY[iSeg + 1]
    z2 = nodeZ[iSeg + 1]
    r2 = nodeRoll[iSeg + 1]
    dxs = x2 - x1
    dys = y2 - y1
    chord = SQR (dxs * dxs + dys * dys)
    angSeg = segArc[iSeg]
    isArc = 0
    IF ABS (angSeg) > 0.01 AND ABS (angSeg) < 359.9 AND chord > EPS THEN isArc = 1

    nStep = 1
    segLen = chord
    IF isArc THEN
        radSeg = chord / (2 * SIN (ABS (angSeg) / 2))
        stepMax = 10
        IF tolSafe < radSeg THEN stepMax = 2 * ACS (1 - tolSafe / radSeg)
        nStep = MAX (1, CEIL (ABS (angSeg) / MAX (0.5, stepMax)))
        ! centre: from the chord midpoint along the left normal, signed by the arc
        dCen = chord / 2 * COS (angSeg / 2) / SIN (angSeg / 2)
        cenX = (x1 + x2) / 2 - dys / chord * dCen
        cenY = (y1 + y2) / 2 + dxs / chord * dCen
        vX = x1 - cenX
        vY = y1 - cenY
        segLen = radSeg * ABS (angSeg) * PI / 180
    ENDIF
    nStep = MAX (nStep, CEIL (ABS (r2 - r1) / 5))
    nStep = MIN (nStep, 720)

    ! unit plan tangents at the segment ends, and the rise per plan metre
    IF isArc THEN
        sgnArc = SGN (angSeg)
        t1x = -vY / radSeg * sgnArc
        t1y = vX / radSeg * sgnArc
        t2x = -(y2 - cenY) / radSeg * sgnArc
        t2y = (x2 - cenX) / radSeg * sgnArc
    ELSE
        t1x = 1
        t1y = 0
        IF chord > EPS THEN
            t1x = dxs / chord
            t1y = dys / chord
        ENDIF
        t2x = t1x
        t2y = t1y
    ENDIF
    riseSeg = 0
    IF segLen > EPS THEN riseSeg = (z2 - z1) / segLen
    IF iSeg = 1 THEN
        startTX = t1x
        startTY = t1y
        startTZ = riseSeg
    ENDIF
    endTX = t2x
    endTY = t2y
    endTZ = riseSeg
    sTx[iSeg] = t1x
    sTy[iSeg] = t1y
    sTz[iSeg] = riseSeg
    eTx[iSeg] = t2x
    eTy[iSeg] = t2y
    eTz[iSeg] = riseSeg
    segIsArc[iSeg] = isArc
    segAng[iSeg] = angSeg
    IF isArc THEN
        segCx[iSeg] = cenX
        segCy[iSeg] = cenY
        segR[iSeg] = radSeg
        a0Seg = ACS (MAX (-1, MIN (1, vX / radSeg)))
        IF vY < 0 THEN a0Seg = 360 - a0Seg
        segA0[iSeg] = a0Seg
    ENDIF

    stubT = 0
    IF segLen > 4 * STUB_LEN THEN stubT = STUB_LEN / segLen
    nT = 0
    FOR kStep = 0 TO nStep
        IF kStep = nStep AND stubT > 0 AND 1 - stubT > (nStep - 1) / nStep THEN
            nT = nT + 1
            tList[nT] = 1 - stubT
        ENDIF
        nT = nT + 1
        tList[nT] = kStep / nStep
        IF kStep = 0 AND stubT > 0 AND stubT < 1 / nStep THEN
            nT = nT + 1
            tList[nT] = stubT
        ENDIF
    NEXT kStep

    FOR iT = 1 TO nT
        tt = tList[iT]
        IF isArc THEN
            th = angSeg * tt
            px = cenX + vX * COS (th) - vY * SIN (th)
            py = cenY + vX * SIN (th) + vY * COS (th)
        ELSE
            px = x1 + dxs * tt
            py = y1 + dys * tt
        ENDIF
        pz = z1 + (z2 - z1) * tt
        pr = r1 + (r2 - r1) * tt
        addIt = 1
        IF nPath > 0 THEN
            dd = SQR ((px - pathX[nPath])^2 + (py - pathY[nPath])^2 + (pz - pathZ[nPath])^2)
            IF dd < 0.001 THEN addIt = 0
        ENDIF
        IF addIt THEN
            nPath = nPath + 1
            pathX[nPath] = px
            pathY[nPath] = py
            pathZ[nPath] = pz
            pathRoll[nPath] = pr
        ENDIF
        IF iT = 1 THEN nodePath[iSeg] = nPath
    NEXT iT
    nodePath[iSeg + 1] = nPath
NEXT iSeg

! ---- end cuts: the cut plane at node 1 (index 1) and the last node (2) ----
! ecN* is the plane's normal pointing out of the beam. The plan angle turns
! the cut counter-clockwise from square in plan; the tilt leans the top of the
! face out past the end, 0 being square to the beam, so a tilt equal to the
! slope there (ecPlumb) gives a vertical face. Both 0 keeps TUBE's own square
! end (ecOn 0), so beams without cuts draw as before. ecTan is the tangent of
! the angle between the cut and square, for the overshoot the 3D script adds.
DIM ecOn[], ecNx[], ecNy[], ecNz[], ecTan[], ecPlumb[]
FOR iE = 1 TO 2
    IF iE = 1 THEN
        ePx = -startTX
        ePy = -startTY
        eRise = -startTZ
        ePlan = cutStartPlan
        eTilt = cutStartTilt
    ELSE
        ePx = endTX
        ePy = endTY
        eRise = endTZ
        ePlan = cutEndPlan
        eTilt = cutEndTilt
    ENDIF
    ! a plan grip drag can arrive as 350 for -10
    WHILE ePlan > 180 DO
        ePlan = ePlan - 360
    ENDWHILE
    WHILE ePlan <= -180 DO
        ePlan = ePlan + 360
    ENDWHILE
    ePlan = MAX (-80, MIN (80, ePlan))
    eTilt = MAX (-85, MIN (85, eTilt))
    ePhi = ATN (eRise)
    ecPlumb[iE] = ePhi
    ecOn[iE] = 0
    IF nNode > 1 AND (ABS (ePlan) > 0.01 OR ABS (eTilt) > 0.01) THEN ecOn[iE] = 1
    eLean = MAX (-89, MIN (89, ePhi - eTilt))
    ecNx[iE] = (ePx * COS (ePlan) - ePy * SIN (ePlan)) * COS (eLean)
    ecNy[iE] = (ePx * SIN (ePlan) + ePy * COS (ePlan)) * COS (eLean)
    ecNz[iE] = SIN (eLean)
    eCos = (ecNx[iE] * ePx + ecNy[iE] * ePy + ecNz[iE] * eRise) / SQR (1 + eRise * eRise)
    ecTan[iE] = 20
    IF eCos > 0.05 THEN ecTan[iE] = MIN (20, TAN (ACS (MIN (1, eCos))))
NEXT iE

! ---- kinks: nodes where the path changes direction by more than 1 degree ----
! The 3D script splits the sweep there and trims both sides with the mitre
! plane (normal kinkNx, kinkNy, kinkNz). The plane is vertical and bisects the
! two directions in plan, a plumb mitre cut: it projects to one line in plan,
! so both sides meet on the same mitre line there. A 3D bisector plane would
! lean when the path rises, and the two sides' cut edges would drift apart in
! plan (gate A). Only a turn to or from a vertical direction falls back to it.
DIM nodeKink[], kinkNx[], kinkNy[], kinkNz[], kinkTurn[]
FOR iN = 1 TO nNode
    nodeKink[iN] = 0
    kinkNx[iN] = 0
    kinkNy[iN] = 0
    kinkNz[iN] = 1
    kinkTurn[iN] = 0
NEXT iN
FOR iN = 2 TO nNode - 1
    kax = eTx[iN - 1]
    kay = eTy[iN - 1]
    kaz = eTz[iN - 1]
    kbx = sTx[iN]
    kby = sTy[iN]
    kbz = sTz[iN]
    kla = SQR (kax * kax + kay * kay + kaz * kaz)
    klb = SQR (kbx * kbx + kby * kby + kbz * kbz)
    IF kla > EPS AND klb > EPS THEN
        kax = kax / kla
        kay = kay / kla
        kaz = kaz / kla
        kbx = kbx / klb
        kby = kby / klb
        kbz = kbz / klb
        kCos = kax * kbx + kay * kby + kaz * kbz
        IF kCos < COS (1) THEN
            nodeKink[iN] = 1
            kinkTurn[iN] = ACS (MAX (-1, MIN (1, kCos)))
            ksx = eTx[iN - 1] + sTx[iN]
            ksy = eTy[iN - 1] + sTy[iN]
            kls = SQR (ksx * ksx + ksy * ksy)
            IF kls > 0.01 THEN
                kinkNx[iN] = ksx / kls
                kinkNy[iN] = ksy / kls
                kinkNz[iN] = 0
            ELSE
                ksx = kax + kbx
                ksy = kay + kby
                ksz = kaz + kbz
                kls = SQR (ksx * ksx + ksy * ksy + ksz * ksz)
                kinkNx[iN] = kax
                kinkNy[iN] = kay
                kinkNz[iN] = kaz
                IF kls > EPS THEN
                    kinkNx[iN] = ksx / kls
                    kinkNy[iN] = ksy / kls
                    kinkNz[iN] = ksz / kls
                ENDIF
            ENDIF
        ENDIF
    ENDIF
NEXT iN
