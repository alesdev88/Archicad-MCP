! Swept Beam -- Parameter Script
! Runs after every edit. No Profile requests here (not allowed in this script).
! 1 repair the arrays, 2 react to the edit, 3 park the grip helpers, 4 write back.

VALUES "profileMode" "Rectangle", "Profile attribute"
VALUES "pathTolerance" RANGE [0.0005, 0.05]
VALUES "rectW" RANGE (0, ]
VALUES "rectH" RANGE (0, ]
VALUES "textSizeMm" RANGE (0, ]
VALUES "gs_ui_current_page" 1, 2, 3
VALUES "gripMode" "All", "Nodes", "Curves", "Add nodes"
HIDEPARAMETER "B", "ZZYZX", "segSag", "insL", "extStart", "extEnd", "insDone", "extStartDone", "extEndDone", "gs_ui_current_page", "sb_version"
IF profileMode <> "Profile attribute" THEN HIDEPARAMETER "beamProfile"
IF NOT (overrideSurface) THEN HIDEPARAMETER "surfaceOverride"
IF NOT (showAxis) THEN HIDEPARAMETER "axisPen", "axisLineType"
IF NOT (showNodeHeights) THEN HIDEPARAMETER "textPen", "textSizeMm"

EPS = 0.0001
EXT_PARK = 0.5
jIns = 0
! One-shot grips. Archicad runs this script several times after one edit and
! GLOB_MODPAR_NAME keeps the last edited name all that time, so a helper grip is
! applied only when it holds a value not applied yet (the *Done markers), and
! its dragged value is kept while it is still the last edit: setting it back in
! the drag run makes Archicad drop the whole edit (gate C).
insDoneOut = -1
extStartOut = EXT_PARK
extStartDoneOut = -1
extEndOut = EXT_PARK
extEndDoneOut = -1
IF GLOB_MODPAR_NAME = "insL" THEN insDoneOut = insDone
IF GLOB_MODPAR_NAME = "extStart" THEN
    extStartOut = extStart
    extStartDoneOut = extStartDone
ENDIF
IF GLOB_MODPAR_NAME = "extEnd" THEN
    extEndOut = extEnd
    extEndDoneOut = extEndDone
ENDIF

! ---- 1. copy and repair: every array gets the length of nodeX ----
DIM nx[], ny[], nz[], nr[], na[]
n = VARDIM1 (nodeX)
IF n < 1 THEN
    n = 2
    nx[1] = 0
    nx[2] = 3
    ny[1] = 0
    ny[2] = 0
    nz[1] = 0
    nz[2] = 0
    nr[1] = 0
    nr[2] = 0
    na[1] = 0
    na[2] = 0
ELSE
    FOR i = 1 TO n
        nx[i] = nodeX[i]
        ny[i] = 0
        IF i <= VARDIM1 (nodeY) THEN ny[i] = nodeY[i]
        nz[i] = 0
        IF i <= VARDIM1 (nodeZ) THEN nz[i] = nodeZ[i]
        nr[i] = 0
        IF i <= VARDIM1 (nodeRoll) THEN nr[i] = nodeRoll[i]
        na[i] = 0
        IF i <= VARDIM1 (segArc) THEN na[i] = segArc[i]
    NEXT i
ENDIF
IF n = 1 THEN
    n = 2
    nx[2] = nx[1] + 1
    ny[2] = ny[1]
    nz[2] = nz[1]
    nr[2] = nr[1]
    na[2] = 0
ENDIF
na[n] = 0

! ---- 2. reactions ----
newA = A
IF n = 2 AND ABS (na[1]) < 0.01 THEN
    ddx = nx[2] - nx[1]
    ddy = ny[2] - ny[1]
    lenPlan = SQR (ddx * ddx + ddy * ddy)
    ! A drives node 2 only when A itself is edited; otherwise A follows the
    ! nodes (an API placement brings the Object tool's A, which must not win)
    newA = lenPlan
    IF GLOB_MODPAR_NAME = "A" THEN
        newA = A
        IF ABS (A - lenPlan) > 0.0005 AND A > EPS THEN
            ux = 1
            uy = 0
            IF lenPlan > EPS THEN
                ux = ddx / lenPlan
                uy = ddy / lenPlan
            ENDIF
            nx[2] = nx[1] + ux * A
            ny[2] = ny[1] + uy * A
        ENDIF
    ENDIF
ENDIF

IF GLOB_UI_BUTTON_ID = 1 THEN
    sAcc = 0
    FOR i = 2 TO n
        jSeg = i - 1
        GOSUB "seg"
        sAcc = sAcc + sLen
        nz[i] = nz[1] + slopePercent / 100 * sAcc
    NEXT i
ENDIF

! arc grip: a moved segSag item becomes that segment's arc angle
IF GLOB_MODPAR_NAME = "segSag" THEN
    FOR j = 1 TO n - 1
        IF j <= VARDIM1 (segSag) THEN
            jSeg = j
            GOSUB "seg"
            IF sChord > EPS THEN
                sOld = 0
                IF sIsArc THEN sOld = sChord / 2 * TAN (na[j] / 4)
                IF ABS (segSag[j] - sOld) > 0.0005 THEN na[j] = 4 * ATN (2 * segSag[j] / sChord)
            ENDIF
        ENDIF
    NEXT j
ENDIF

! insert grip: slid along segment j (a one-way grip, like the curve grip), it
! inserts a node at that point of the segment, on the arc if the segment is one
IF GLOB_MODPAR_NAME = "insL" THEN
    jIns = 0
    FOR j = 1 TO n - 1
        IF jIns = 0 AND j <= VARDIM1 (insL) THEN
            jSeg = j
            GOSUB "seg"
            IF sChord > EPS AND ABS (insL[j] - sChord / 3) > 0.001 AND ABS (insL[j] - insDone) > 0.000001 THEN jIns = j
        ENDIF
    NEXT j
    IF jIns > 0 THEN
        jSeg = jIns
        GOSUB "seg"
        insDoneOut = insL[jIns]
        tIns = MAX (0.02, MIN (0.98, insL[jIns] / sChord))
        IF sIsArc THEN
            pth = na[jIns] * tIns
            pvx = nx[jIns] - sCx
            pvy = ny[jIns] - sCy
            newX = sCx + pvx * COS (pth) - pvy * SIN (pth)
            newY = sCy + pvx * SIN (pth) + pvy * COS (pth)
        ELSE
            newX = nx[jIns] + (nx[jIns + 1] - nx[jIns]) * tIns
            newY = ny[jIns] + (ny[jIns + 1] - ny[jIns]) * tIns
        ENDIF
        newZ = nz[jIns] + (nz[jIns + 1] - nz[jIns]) * tIns
        newR = nr[jIns] + (nr[jIns + 1] - nr[jIns]) * tIns
        a1 = na[jIns] * tIns
        a2 = na[jIns] * (1 - tIns)
        FOR k = n TO jIns + 1 STEP -1
            nx[k + 1] = nx[k]
            ny[k + 1] = ny[k]
            nz[k + 1] = nz[k]
            nr[k + 1] = nr[k]
            na[k + 1] = na[k]
        NEXT k
        nx[jIns + 1] = newX
        ny[jIns + 1] = newY
        nz[jIns + 1] = newZ
        nr[jIns + 1] = newR
        na[jIns] = a1
        na[jIns + 1] = a2
        n = n + 1
        na[n] = 0
    ENDIF
ENDIF

! add-node grips past the ends: slid out along the end direction, they append
! (or prepend) a node that far away, continuing the slope, like continuing a wall
IF GLOB_MODPAR_NAME = "extEnd" AND ABS (extEnd - EXT_PARK) > 0.001 AND extEnd > 0.01 AND ABS (extEnd - extEndDone) > 0.000001 THEN
    extEndDoneOut = extEnd
    jSeg = n - 1
    GOSUB "seg"
    GOSUB "tans"
    nx[n + 1] = nx[n] + tanEx * extEnd
    ny[n + 1] = ny[n] + tanEy * extEnd
    nz[n + 1] = nz[n] + tRise * extEnd
    nr[n + 1] = nr[n]
    na[n] = 0
    n = n + 1
    na[n] = 0
ENDIF
IF GLOB_MODPAR_NAME = "extStart" AND ABS (extStart - EXT_PARK) > 0.001 AND extStart > 0.01 AND ABS (extStart - extStartDone) > 0.000001 THEN
    extStartDoneOut = extStart
    jSeg = 1
    GOSUB "seg"
    GOSUB "tans"
    FOR k = n TO 1 STEP -1
        nx[k + 1] = nx[k]
        ny[k + 1] = ny[k]
        nz[k + 1] = nz[k]
        nr[k + 1] = nr[k]
        na[k + 1] = na[k]
    NEXT k
    nx[1] = nx[2] - tanSx * extStart
    ny[1] = ny[2] - tanSy * extStart
    nz[1] = nz[2] - tRise * extStart
    nr[1] = nr[2]
    na[1] = 0
    n = n + 1
    na[n] = 0
ENDIF

! merge: a node dragged within 1 cm (plan) of a neighbour disappears
IF (GLOB_MODPAR_NAME = "nodeX" OR GLOB_MODPAR_NAME = "nodeY" OR GLOB_MODPAR_NAME = "nodeZ") AND n > 2 THEN
    j = 1
    WHILE j < n AND n > 2 DO
        dPlan = SQR ((nx[j + 1] - nx[j])^2 + (ny[j + 1] - ny[j])^2)
        IF dPlan < 0.01 THEN
            jDel = j + 1
            IF jDel = n THEN jDel = j
            IF jDel > 1 AND jDel < n THEN
                lenA = SQR ((nx[jDel] - nx[jDel - 1])^2 + (ny[jDel] - ny[jDel - 1])^2)
                lenB = SQR ((nx[jDel + 1] - nx[jDel])^2 + (ny[jDel + 1] - ny[jDel])^2)
                IF lenB > lenA THEN na[jDel - 1] = na[jDel]
            ENDIF
            FOR k = jDel TO n - 1
                nx[k] = nx[k + 1]
                ny[k] = ny[k + 1]
                nz[k] = nz[k + 1]
                nr[k] = nr[k + 1]
                na[k] = na[k + 1]
            NEXT k
            n = n - 1
            na[n] = 0
        ELSE
            j = j + 1
        ENDIF
    ENDWHILE
ENDIF

! ---- 3. park the grip helpers ----
DIM sag[], il[]
FOR j = 1 TO n
    sag[j] = 0
    il[j] = 0
    IF j < n THEN
        jSeg = j
        GOSUB "seg"
        IF sIsArc THEN sag[j] = sChord / 2 * TAN (na[j] / 4)
        il[j] = sChord / 3
    ENDIF
NEXT j
! keep the dragged insert grip where it was dropped while it is the last edit
IF GLOB_MODPAR_NAME = "insL" AND insDoneOut >= 0 THEN
    FOR j = 1 TO n
        IF j <= VARDIM1 (insL) THEN
            IF ABS (insL[j] - insDoneOut) < 0.000001 THEN il[j] = insL[j]
        ENDIF
    NEXT j
ENDIF

! ---- 4. write back, with arrays of exactly n items ----
DIM ox[], oy[], oz[], orl[], oa[], os[], oil[]
FOR i = 1 TO n
    ox[i] = nx[i]
    oy[i] = ny[i]
    oz[i] = nz[i]
    orl[i] = nr[i]
    oa[i] = na[i]
    os[i] = sag[i]
    oil[i] = il[i]
NEXT i
PARAMETERS nodeX = ox, nodeY = oy, nodeZ = oz, nodeRoll = orl, segArc = oa, segSag = os, insL = oil, extStart = extStartOut, extEnd = extEndOut, insDone = insDoneOut, extStartDone = extStartDoneOut, extEndDone = extEndDoneOut, A = newA
END

! ---- subroutines ----
"seg":
    ! plan geometry of segment jSeg (node jSeg to jSeg + 1)
    sdx = nx[jSeg + 1] - nx[jSeg]
    sdy = ny[jSeg + 1] - ny[jSeg]
    sChord = SQR (sdx * sdx + sdy * sdy)
    sIsArc = 0
    sRad = 0
    sCx = 0
    sCy = 0
    sLen = sChord
    IF ABS (na[jSeg]) > 0.01 AND ABS (na[jSeg]) < 359.9 AND sChord > EPS THEN
        sIsArc = 1
        sRad = sChord / (2 * SIN (ABS (na[jSeg]) / 2))
        sD = sChord / 2 * COS (na[jSeg] / 2) / SIN (na[jSeg] / 2)
        sCx = (nx[jSeg] + nx[jSeg + 1]) / 2 - sdy / sChord * sD
        sCy = (ny[jSeg] + ny[jSeg + 1]) / 2 + sdx / sChord * sD
        sLen = sRad * ABS (na[jSeg]) * PI / 180
    ENDIF
RETURN

"tans":
    ! unit plan tangents at the start (tanSx, tanSy) and end (tanEx, tanEy) of segment
    ! jSeg after "seg", and its rise per plan metre (tRise)
    IF sIsArc THEN
        tsg = SGN (na[jSeg])
        tanSx = -(ny[jSeg] - sCy) / sRad * tsg
        tanSy = (nx[jSeg] - sCx) / sRad * tsg
        tanEx = -(ny[jSeg + 1] - sCy) / sRad * tsg
        tanEy = (nx[jSeg + 1] - sCx) / sRad * tsg
    ELSE
        tanSx = 1
        tanSy = 0
        IF sChord > EPS THEN
            tanSx = sdx / sChord
            tanSy = sdy / sChord
        ENDIF
        tanEx = tanSx
        tanEy = tanSy
    ENDIF
    tRise = 0
    IF sLen > EPS THEN tRise = (nz[jSeg + 1] - nz[jSeg]) / sLen
RETURN
